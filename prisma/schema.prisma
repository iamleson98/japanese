// Prisma schema for the Nihongo Path Japanese learning app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Hiragana / Katakana characters (the kana syllabary)
model Kana {
  id        String  @id @default(cuid())
  char      String  @unique // the kana character
  romaji    String  // romanization (NOT unique: ぢ and じ both = "ji")
  type      String  // "hiragana" | "katakana"
  row      String  // gojuon row, e.g. "vowels", "k", "s", "t", "n"
  order     Int    // display order
  pair      String? // e.g. hiragana あ pair is katakana ア
  audio     String? // optional audio file path
}

/// Vocabulary words organised by JLPT level
model Vocabulary {
  id          String  @id @default(cuid())
  word        String  // kanji form e.g. 食べる
  reading     String  // kana reading e.g. たべる
  meaning     String  // english meaning
  romaji      String? // romanization
  level       String  // "N5" | "N4" | "N3"
  category    String  // "greetings","verbs","nouns","adjectives","adverbs","particles","family","food","numbers","time","counters","conjunctions","colors","body","nature","places","pronouns","question"
  pos         String? // part of speech: "verb","noun","i-adjective","na-adjective","adverb","particle","expression","pronoun","number"
  verbGroup   String? // for verbs only: "godan" | "ichidan" | "irregular"
  pitchAccent String? // pitch accent pattern code, e.g. "0" heiban, "1" atamadaka
  lesson      Int?    // lesson number for guided study (1..N)
  exampleJp   String? // example sentence (jp)
  exampleEn   String? // example sentence (en)
  exampleJp2  String? // second example (jp)
  exampleEn2  String? // second example (en)
  order       Int    @default(0)
}

/// Grammar points
model Grammar {
  id           String  @id @default(cuid())
  title        String  // short title e.g. "〜ます (masu form)"
  level        String  // "N5" | "N4" | "N3"
  structure    String  // pattern e.g. "V(ます stem) + ます"
  meaning      String  // english meaning
  explanation  String  // long explanation
  exampleJp    String  // example sentence jp
  exampleEn    String  // example sentence en
  exampleJp2   String? // second example
  exampleEn2   String? // second example
  note         String? // usage notes / caution
  commonMistake String? // what learners get wrong
  lesson       Int?    // lesson number
  order        Int     @default(0)
}

/// Kanji characters
model Kanji {
  id          String  @id @default(cuid())
  character   String  @unique // the kanji
  onyomi      String  // on-reading (kanji origin), comma separated
  kunyomi     String  // kun-reading (native), comma separated
  meaning     String  // english meaning
  level       String  // "N5" | "N4" | "N3"
  strokeCount Int     @default(0)
  jlpt        String  @default("N5")
  radical     String? // radical
  mnemonic    String? // memory aid story
  exampleWord String? // common word using this kanji
  exampleRead String? // reading of the example word
  exampleMean String? // meaning of the example word
  order       Int     @default(0)
}

/// Japanese counters (助数詞) with sound-change rules
model Counter {
  id           String  @id @default(cuid())
  kanji        String  // e.g. 本
  reading      String  // e.g. ほん
  meaning      String  // what it counts, e.g. "long, thin objects"
  level        String  // "N5" | "N4" | "N3"
  // Sound changes for 1-10 (comma separated)
  one          String  // e.g. いっぽん
  two          String  // e.g. にほん
  three        String  // e.g. さんぼん
  four         String  // e.g. よんほん
  five         String  // e.g. ごほん
  six          String  // e.g. ろっぽん
  seven        String  // e.g. ななほん
  eight        String  // e.g. はっぽん
  nine         String  // e.g. きゅうほん
  ten          String  // e.g. じゅっぽん
  exampleJp    String? // example sentence
  exampleEn    String?
  note         String? // sound-change notes
  order        Int     @default(0)
}

/// Verb / adjective conjugation paradigms
model Conjugation {
  id           String  @id @default(cuid())
  verb         String  // dictionary form, e.g. 食べる
  reading      String  // たべる
  group        String  // "godan" | "ichidan" | "irregular" | "i-adj" | "na-adj"
  level        String  // "N5" | "N4" | "N3"
  meaning      String  // english
  dict         String  // dictionary form 食べる
  masu         String  // polite 食べます
  nai          String  // negative 食べない
  ta           String  // past 食べた
  te           String  // te-form 食べて
  potential    String? // 食べられる
  passive      String? // 食べられる (passive)
  causative    String? // 食べさせる
  volitional   String? // 食べよう
  conditional  String? // 食べれば
  imperative   String? // 食べろ
  order        Int     @default(0)
}

/// Curated YouTube videos / channels / playlists
model Resource {
  id          String  @id @default(cuid())
  title       String
  url         String
  type        String  // "video" | "playlist" | "channel"
  level       String  // "N5" | "N4" | "N3" | "all"
  topic       String  // "kana" | "grammar" | "vocabulary" | "kanji" | "listening" | "particles" | "reading"
  description String
  order       Int     @default(0)
}

/// Flashcard SRS progress (single shared learner profile)
model FlashcardProgress {
  id           String   @id @default(cuid())
  itemType    String   // "vocabulary" | "kana" | "kanji" | "grammar"
  itemId      String   // id of the underlying item
  box         Int      @default(0) // Leitner box 0..5 (0 = new)
  ease        Float    @default(2.5) // ease factor
  interval    Int      @default(0) // days until next review
  dueAt       DateTime @default(now())
  lastSeenAt DateTime?
  reps        Int      @default(0)
  lapses      Int      @default(0)
  correct     Int      @default(0)
  wrong       Int      @default(0)

  @@unique([itemType, itemId])
}

/// Daily streak / goals
model Stats {
  id           String   @id @default(cuid())
  key          String   @unique
  value        Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// Simple daily activity log (date -> cards reviewed)
model DailyActivity {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD (local date)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}
